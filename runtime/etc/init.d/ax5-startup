#!/bin/sh /etc/rc.common
# rc.common consumes these variables.
# shellcheck disable=SC2034
START=99
# shellcheck disable=SC2034
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/ax5-startup-worker
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
