--- a/utils/lvm2/files/lvm2.preinit
+++ b/utils/lvm2/files/lvm2.preinit
@@ -10,12 +10,19 @@
 # partition for this to work.
 
 do_startlvm() {
+        # This board boots a plain GPT rootfs. LVM root is an explicit opt-in.
+        if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = redmi,ax5-jdcloud ]; then
+                case " $(cat /proc/cmdline) " in
+                        *" ax5.lvm_root=1 "*) ;;
+                        *) return 0 ;;
+                esac
+        fi
         echo "Starting lvm2 during preinit" > /dev/kmsg
         # The following 3 lines are copied from from the start function
         # in /etc/rc.d/S15lvm2 which is copyright by Stefan Monnier
         mkdir -p /tmp/lvm/cache
-        /sbin/lvm vgscan --ignorelockingfailure --mknodes > /dev/kmsg || :
-        /sbin/lvm vgchange -aly --ignorelockingfailure > /dev/kmsg || return 2
+        /sbin/lvm vgscan --ignorelockingfailure --mknodes 3>&- > /dev/kmsg || :
+        /sbin/lvm vgchange -aly --ignorelockingfailure 3>&- > /dev/kmsg || return 2
 }
 
 # Perform the function only if lvm2 is enabled by the user
--- a/utils/lvm2/files/lvm2.init
+++ b/utils/lvm2/files/lvm2.init
@@ -3,12 +3,15 @@
 START=15
 
 start () {
+        if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = redmi,ax5-jdcloud ]; then
+                [ "$(uci -q get ax5_storage.settings.auto_activate)" = 1 ] || return 0
+        fi
 	mkdir -p /tmp/lvm/cache
-	/sbin/lvm vgscan --ignorelockingfailure --mknodes || :
-	/sbin/lvm vgchange -aly --ignorelockingfailure || return 2
+	/sbin/lvm vgscan --ignorelockingfailure --mknodes 3>&- || :
+	/sbin/lvm vgchange -aly --ignorelockingfailure 3>&- || return 2
 }
 
 stop () {
 	mkdir -p /tmp/lvm/cache
-	/sbin/lvm vgchange -aln --ignorelockingfailure || return 2
+	/sbin/lvm vgchange -aln --ignorelockingfailure 3>&- || return 2
 }
--- a/utils/lvm2/files/lvm2.hotplug
+++ b/utils/lvm2/files/lvm2.hotplug
@@ -1,6 +1,10 @@
+# AX5 data is ext4; do not activate foreign VG metadata unless requested.
+if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = redmi,ax5-jdcloud ]; then
+        [ "$(uci -q get ax5_storage.settings.auto_activate)" = 1 ] || return 0
+fi
 
 [ "$ACTION" = "add" ] || return 0
 [ -e "/dev/$DEVNAME" ] || return 0
 
-/sbin/lvm vgscan --mknodes --devices /dev/$DEVNAME || :
-/sbin/lvm vgchange -aly --devices /dev/$DEVNAME || :
+/sbin/lvm vgscan --mknodes --devices /dev/$DEVNAME 3>&- || :
+/sbin/lvm vgchange -aly --devices /dev/$DEVNAME 3>&- || :
