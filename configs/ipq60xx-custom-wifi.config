# AX5 JDCloud only. This is a seed, not a dependency-expanded .config.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_DEVEL=y
CONFIG_USE_APK=y
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR="$(TOPDIR)/.ccache"

# Match the running device's memory profile and NSS 12.5 firmware.
CONFIG_IPQ_MEM_PROFILE_512=y
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y

# Administration, diagnostics and existing personal tools.
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssh-sftp-server=y

# No partition, filesystem or data migration is performed by this repository.
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-fs-cifs=y

# Logical storage capabilities only; never repartition or create mappings at boot.
CONFIG_PACKAGE_kmod-dm=y
CONFIG_PACKAGE_kmod-ax5-dynamic-storage=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_lvm2=y
CONFIG_PACKAGE_cryptsetup=y
CONFIG_PACKAGE_veritysetup=y
CONFIG_PACKAGE_integritysetup=y

# RAM-only swap: size and compressor are set by the first-boot defaults.
CONFIG_KERNEL_SWAP=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZO=y

# VPN and diagnostics; NSS remains the only selected hardware offload stack.
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-sched-cake=y

# Build matching optional APKs without installing unused filesystems/containers.
CONFIG_PACKAGE_kmod-fs-btrfs=m
CONFIG_PACKAGE_kmod-fs-xfs=m
CONFIG_PACKAGE_kmod-veth=m

# Install services in the image rather than only building optional APKs (=m).
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-admin=y
CONFIG_PACKAGE_samba4-client=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_SAMBA4_SERVER_VFS=y
CONFIG_SAMBA4_SERVER_NETBIOS=y
CONFIG_SAMBA4_SERVER_AVAHI=y
CONFIG_SAMBA4_SERVER_WSDD2=y
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_wsdd2=y
CONFIG_PACKAGE_minidlna=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_nfs-utils=y
CONFIG_PACKAGE_kmod-fs-nfsd=y
CONFIG_PACKAGE_rpcbind=y

# Reproducible file-based direct-I/O diagnostics; never benchmark at first boot.
CONFIG_PACKAGE_fio=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_ethtool=y

# Observe CPU/memory/I/O contention before changing affinity or queue limits.
CONFIG_KERNEL_PSI=y
