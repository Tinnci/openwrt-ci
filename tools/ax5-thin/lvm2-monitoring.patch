--- /dev/null
+++ b/utils/lvm2/files/dmeventd.init
@@ -0,0 +1,12 @@
+#!/bin/sh /etc/rc.common
+
+START=12
+STOP=10
+USE_PROCD=1
+
+start_service() {
+	procd_open_instance
+	procd_set_param command /usr/sbin/dmeventd -f
+	procd_set_param respawn 3600 5 0
+	procd_close_instance
+}
